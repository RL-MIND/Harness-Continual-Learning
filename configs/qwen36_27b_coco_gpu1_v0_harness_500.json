    "log_prompt_chars": 8000
  },
  "execution": {
    "read_only_workers": 2,
    "run_train_final": false
  },
  "task_interface": {
    "mode": "auto",
    "max_new_tokens": 640,
    "invalid_output_retries": 1,
    "retry_max_new_tokens": 1024,
    "fallback_to_rules_on_invalid": true
  },
  "router": {
    "route_name": "qwen36_27b_coco_gpu3_v0_harness",
    "strip_output": true,
    "use_llm_workflow_selector": true,
    "use_memory_selector": true,
    "memory_always_on": true,
    "use_skill_selector": true,
    "use_tool_selector": false,
    "tool_auto_select": false,
    "use_chat_tool_calls": false,
    "memory_selector_max_new_tokens": 256,
    "memory_selector_invalid_output_retries": 1,
    "memory_selector_retry_max_new_tokens": 256,
    "skill_selector_max_new_tokens": 256,
    "skill_selector_invalid_output_retries": 1,
    "skill_selector_retry_max_new_tokens": 256,
    "skill_selector_fallback_to_empty_on_invalid": true,
    "capability_enabled": false,
    "capability_execution_mode": "disabled"
  },
  "optimizer": {
    "candidate_count": 0,
    "components": []
  },
  "memory": {
    "enabled": true,
    "raw_capacity_per_task": 10,
    "abstract_capacity_per_task": 2,
    "anchor_capacity_per_task": 25,
    "retrieval_top_k": 2,
    "reset_on_start": true,
    "abstract_mode": "llm",
    "abstract_max_new_tokens": 512,
    "anchor_selection_mode": "llm",
    "anchor_count_per_batch": 2,
    "anchor_candidate_limit": 10,
    "anchor_selection_max_new_tokens": 128,
    "skill_enabled": true,
    "skill_mode": "llm"
  },
  "forgetting_probe": {
    "enabled": false
  },
  "task_stream_path": "configs/taskstream_multimodal_main_250_50_500.json",
  "reset_run_on_start": false,
  "storage_dir": "storage/experiments/qwen36_27b_coco_gpu1_v0_harness_500",
  "prediction_cache": {
    "enabled": true,
    "path": "storage/experiments/qwen36_27b_coco_gpu1_v0_harness_500/prediction_cache/read_only_predictions.jsonl"
  },
  "checkpoint": {
    "enabled": true,
    "path": "storage/experiments/qwen36_27b_coco_gpu1_v0_harness_500/checkpoint.json",
    "resume": true
  },
  "task_flow": [
    {
      "name": "test",
      "phase": "test",
      "test_split": "test",
      "test_limit_per_task": 500,
      "group_by_task": true
    }
  ]
}
