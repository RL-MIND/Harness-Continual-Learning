{
  "project_name": "Qwen3.6-27B COCO fixed v0 harness 500-test migrated",
  "model": {
    "backend": "chat_completions",
    "name": "qwen3.6-27b-coco-ablation-gpu3",
    "paper_model_name": "Qwen3.6-27B",
    "base_url": "http://127.0.0.1:8007",
    "api_key": "EMPTY",
    "max_new_tokens": 1024,
    "answer_max_new_tokens": 1024,
    "temperature": 0.0,
    "cleanup_output": true,
    "enable_image_input": true,
    "chat_template_kwargs": {
      "enable_thinking": false
